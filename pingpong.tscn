; ── 球台 ──
[node name="Table" type="StaticBody3D" parent="."]
; ★ collision_layer/mask = 0：关掉球台的物理碰撞。
;   这块 1.525×0.05×2.74 的薄板（y=0.735）默认在第 1 层，而玩家
;   CharacterBody3D 也在第 1 层 —— 于是玩家走到台边就被这块看不见的板挡住，
;   怎么走都上不了台，正是用户反复报的「空气墙」。
;   乒乓球是自绘物理（pingpong_ball 的 _physics_process 自己做弹跳/撞网判定），
;   完全不依赖物理引擎的碰撞，所以关掉它不影响任何东西。
;   关掉之后玩家能站到台前/台上（第一人称看不到自己的身体，视觉上就是「趴在台前」），
;   拍子天然落在台面上方，空气墙消失。
collision_layer = 0
collision_mask = 0

; 混元3D 生成的球台模型，但**已经做过一次网格手术**：原 GLB 里把一把多余的
; 乒乓球拍和球台烘进了同一份几何（球拍是 15 个独立连通壳，凸出台面 ~3 cm），
; 现在换成清理过的 models/table_clean.res。源 GLB 与原始贴图备份在 models/_raw/。
;
; transform 是原来「TableModel 节点(绕Y 90° + 非均匀缩放) × GLB 内部 node_0
; (绕X 90°，glTF Y-up → Godot Z-up)」复合出来的结果，等价写法：
;   rotation_degrees=(0,90,0) scale=(2.703,1.859,2.052) 再乘一个绕X 90°
; 这里直接写成展开后的矩阵，免得依赖欧拉角分解顺序。
; 世界 AABB ≈ X1.525 × Z2.74；模型自身顶面在 y≈0.611、自带网顶到 0.760。
; ★ origin.y = +0.145 是这一版加的：模型整体抬到「顶面 0.756」，
;   让可见台面与物理台面（table_height = 0.76）对齐，理由见文件头「高度账」。
;   抬高后自带网顶到 0.905，落在程序化球网（0.760~0.9125）里面被盖住。
[node name="TableModel" type="MeshInstance3D" parent="Table"]
transform = Transform3D(0, 2.052, 0, 0, 0, -1.859, -2.703, 0, 0, 0, 0.145, 0)
mesh = ExtResource("10_tablemesh")

[node name="TableTop" type="MeshInstance3D" parent="Table"]
; 顶面 0.760 = 物理 table_height；底面 0.745。模型抬到 0.756 的顶面正好夹在中间。
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.7525, 0)
cast_shadow = 0
mesh = SubResource("BoxMesh_tabletop")
material_override = SubResource("Mat_tabletop")

; 抬高模型后腿脚离地 0.145，这 4 块垫子正好垫上（位置=实测贴地几何的质心）。
