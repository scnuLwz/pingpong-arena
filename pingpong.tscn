; 网孔：用贴图 alpha 直接混合（transparency = 1，不是 alpha 裁剪）。
; 近距离看得出一个个网眼；远距离 mipmap 一平均就虚化成一层薄纱 ——
; 这正是真实球网在几米外的样子。裁剪模式反而会「远一点整张网消失」。
albedo_texture = ExtResource("11_nettex")
uv1_scale = Vector3(14.52, 1, 1)
roughness = 0.85
transparency = 1
cull_mode = 2

